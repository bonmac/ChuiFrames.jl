{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/bash_guard.sh\"; if [ -f \"$f\" ]; then exec sh \"$f\"; fi; echo \"[factory] guard hook missing: $f. Failing closed: restore it (julia scripts/sync_factory.jl) or ask the user.\" >&2; exit 2'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/write_guard.sh\"; if [ -f \"$f\" ]; then exec sh \"$f\"; fi; echo \"[factory] guard hook missing: $f. Failing closed: restore it (julia scripts/sync_factory.jl) or ask the user.\" >&2; exit 2'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch_limit.sh\"; if [ -f \"$f\" ]; then exec sh \"$f\"; fi; echo \"[factory] guard hook missing: $f. Failing closed: restore it (julia scripts/sync_factory.jl) or ask the user.\" >&2; exit 2'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd_boundary.sh\"; if [ -f \"$f\" ]; then exec sh \"$f\"; fi; echo \"[factory] guard hook missing: $f. Failing closed: restore it (julia scripts/sync_factory.jl) or ask the user.\" >&2; exit 2'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd_boundary.sh\"; if [ -f \"$f\" ]; then exec sh \"$f\"; fi; echo \"[factory] guard hook missing: $f. Failing closed: restore it (julia scripts/sync_factory.jl) or ask the user.\" >&2; exit 2'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd_commit_post.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task|TaskStop",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/lane_ledger.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd_commit_post.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task|TaskStop",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/lane_ledger.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/lane_ledger.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/lane_ledger.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/lane_ledger.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/teammate_idle.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/precompact.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
